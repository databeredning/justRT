{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      {
        "type": "cortex-debug",
        "request": "launch",
        "name": "Flash and debug justrt",
        "cwd": "${workspaceRoot}",
        "loadFiles": ["${workspaceRoot}/bin/justrt.hex"],
        "executable": "${workspaceRoot}/bin/justrt.elf",
        "runToEntryPoint": "main",
        "serverpath": "C:/Program Files/SEGGER/JLink/JLinkGDBServerCL.exe",
        "armToolchainPath": "C:/devtools/gcc/gcc-10.2-arm32-eabi/bin",
        "servertype": "jlink",
        "device": "S32K312",
        "interface": "jtag",
        "svdFile": "${workspaceRoot}/S32K344_M7.svd",
        "liveWatch": {
          "enabled": true,
          "samplesPerSecond": 4
        },
        "preLaunchTask": "build justrt"
      },
      {
        "type": "cortex-debug",
        "request": "attach",
        "name": "Attach and debug justrt",
        "cwd": "${workspaceRoot}",
        "loadFiles": ["${workspaceRoot}/bin/justrt.hex"],
        "executable": "${workspaceRoot}/bin/justrt.elf",
        "serverpath": "C:/Program Files/SEGGER/JLink/JLinkGDBServerCL.exe",
        "armToolchainPath": "C:/devtools/gcc/gcc-10.2-arm32-eabi/bin",
        "servertype": "jlink",
        "device": "S32K312",
        "interface": "jtag",
        "svdFile": "${workspaceRoot}/S32K344_M7.svd",
        "liveWatch": {
          "enabled": true,
          "samplesPerSecond": 4
        }
      },
      {
        "name": "QEMU: Attach justRT",
        "type": "cortex-debug",
        "request": "attach",
        "servertype": "external",
        "gdbTarget": "localhost:1234",
        "cwd": "${workspaceFolder}",
        "executable": "${workspaceFolder}/bin/qemu-mps2-an385/justrt.elf",
        "armToolchainPath": "C:/devtools/gcc/gcc-10.2-arm32-eabi/bin",
        "runToEntryPoint": "main",
        "showDevDebugOutput": "none"
      }
   ]
}
